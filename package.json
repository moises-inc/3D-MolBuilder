{
  "name": "pide-vcm-molbuilder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive 3D Molecular Builder & Gamification App for USS VcM High-School Science Fairs",
  "author": "Moisés Amundarain Romero & PIDE VcM Team",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --config config/vite.config.ts --host 0.0.0.0 --port 5174\"",
    "dev:lan": "concurrently \"npm run server\" \"vite --config config/vite.config.ts --host 0.0.0.0 --port 5174\"",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "tsc -b config/tsconfig.json && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts --host 0.0.0.0 --port 5174"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.2.4",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.179.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
